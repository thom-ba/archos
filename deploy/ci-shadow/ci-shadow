#!/usr/bin/env bash
# Install, run and remove ci-shadow: CI on runner pods in the cluster, for the test
# copy only. Nothing here touches the real repository's CI. See README.md.
#
#   ci-shadow install      needs KUBECONFIG; CI_SHADOW_GITHUB_TOKEN the first time
#   ci-shadow run [light|full]
#   ci-shadow pr <number> [full|light]   a pull request of archos-at/archos
#   ci-shadow status
#   ci-shadow off          removes everything from the cluster
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
ns=ci-shadow
image="${CI_SHADOW_IMAGE:-ghcr.io/thom-ba/ci-shadow-runner@sha256:10c6213782460b3cc963cd59c6dfdf5a9cd266a9749547c84f6d5e1db1e6212d}"

case "${1:-}" in
  install)
    kubectl apply -f "$here/manifests"
    if [ -n "${CI_SHADOW_GITHUB_TOKEN:-}" ]; then
      kubectl -n "$ns" create secret generic ci-shadow-github \
        --from-file=token=<(printf '%s' "$CI_SHADOW_GITHUB_TOKEN") --dry-run=client -o yaml | kubectl apply -f -
    else
      kubectl -n "$ns" get secret ci-shadow-github >/dev/null \
        || { echo "first install: set CI_SHADOW_GITHUB_TOKEN, a token limited to the test copy" >&2; exit 1; }
    fi
    kubectl -n "$ns" create configmap ci-shadow-scripts \
      --from-file="$here/slot-feeder.sh" --from-file="$here/slot-runner.sh" --from-file="$here/run.sh" --dry-run=client -o yaml | kubectl apply -f -
    for depth in light full; do
      sed -e "s|__DEPTH__|$depth|g" -e "s|__IMAGE__|$image|g" "$here/cronjob.yaml.in" | kubectl apply -f -
    done
    echo "Installed. Idle: no pods. Test it with: $0 run light"
    ;;
  run)
    bash "$here/run.sh" "${2:-light}"
    ;;
  pr)
    # The pull request's head merged with tb/ci-shadow, as a pull request on the test
    # copy; nothing on archos-at/archos changes. Needs push access to the test copy.
    n="${2:?usage: ci-shadow pr <number> [full|light]}"
    test_copy=git@github.com:thom-ba/archos-ci.git
    branch="shadow/pr-$n"
    git -C "$here" fetch -q https://github.com/archos-at/archos.git "pull/$n/head"
    head="$(git -C "$here" rev-parse FETCH_HEAD)"
    git -C "$here" fetch -q "$test_copy" tb/ci-shadow
    shadow="$(git -C "$here" rev-parse FETCH_HEAD)"
    tree="$(git -C "$here" merge-tree --write-tree "$head" "$shadow")" \
      || { echo "#$n conflicts with tb/ci-shadow" >&2; exit 1; }
    # [skip ci]: the push starts nothing; the run starts on the commit slot 0 adds.
    commit="$(git -C "$here" commit-tree "$tree" -p "$head" -p "$shadow" \
      -m "ci-shadow: archos-at/archos#$n at ${head:0:9} [skip ci]")"
    git -C "$here" push -q --force "$test_copy" "$commit:refs/heads/$branch"
    if [ -z "$(gh pr list -R thom-ba/archos-ci --head "$branch" --state open --json number --jq '.[].number')" ]; then
      gh pr create -R thom-ba/archos-ci --head "$branch" --base develop --draft --assignee @me \
        --title "ci-shadow: archos-at/archos#$n" \
        --body "ci-shadow's copy of https://github.com/archos-at/archos/pull/$n merged with tb/ci-shadow. Never merge." >/dev/null
    fi
    # CI reads labels such as no-release-note live, so the copy carries the real ones.
    gh pr view "$n" -R archos-at/archos --json labels --jq '.labels[].name' | while read -r label; do
      gh label create "$label" -R thom-ba/archos-ci --force >/dev/null
      gh pr edit "$branch" -R thom-ba/archos-ci --add-label "$label" >/dev/null
    done
    echo "testing #$n at ${head:0:9} on $branch"
    bash "$here/run.sh" "${3:-full}" "$branch"
    ;;
  status)
    kubectl -n "$ns" get cronjobs,jobs,pods
    kubectl -n "$ns" get resourcequota ci-shadow
    ;;
  off)
    kubectl delete namespace "$ns" --ignore-not-found
    kubectl delete priorityclass ci-shadow-low --ignore-not-found
    echo "Removed. Nothing of ci-shadow is left on the cluster."
    ;;
  *)
    sed -n 2,10p "$0"
    exit 2
    ;;
esac
